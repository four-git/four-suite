{
  "mount": "/mnt/four-security/downloads",
  "source": "//192.168.4.46/data",
  "expected_dirs": [
    "media",
    "torrents/complete"
  ],
  "roots": [
    "torrents/complete",
    "media"
  ],
  "rules": "/opt/four-security/rules/media-payload-indicators.yar",
