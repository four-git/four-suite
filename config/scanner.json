  "max_runtime_seconds": 900,
  "max_files_per_run": 2000,
  "stale_scan_seconds": 86400,
  "retention_days": 30,
  "clam_mode": "daemon",
  "clam_socket": "/tmp/four-security-clamd.sock",
  "media_policy": true,
  "continuation_seconds": 30,
  "retry_seconds": 21600,
