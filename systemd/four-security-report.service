[Unit]
Description=Local scanner health report
After=network-online.target

[Service]
Type=oneshot
User=997
Group=983
WorkingDirectory=/opt/four-security
ExecStart=/usr/bin/python3 /opt/four-security/src/four_security.py health
ExecStart=/usr/bin/python3 /opt/four-security/src/four_security.py status
Nice=15
MemoryMax=128M
TimeoutStartSec=60
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/four-security /var/log/four-security
ReadOnlyPaths=/mnt/four-security
UMask=0027
StandardOutput=append:/var/log/four-security/report.log
StandardError=append:/var/log/four-security/report.log
