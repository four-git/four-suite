[Unit]
Description=Bounded read-only NAS malware scan
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=997
Group=983
WorkingDirectory=/opt/four-security
ExecStart=/usr/bin/python3 /opt/four-security/src/four_security.py scan
SuccessExitStatus=1
Nice=15
IOSchedulingClass=idle
CPUQuota=75%
MemoryMax=1200M
TimeoutStartSec=1000
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/four-security /var/log/four-security
ReadOnlyPaths=/mnt/four-security
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
UMask=0027
StandardOutput=append:/var/log/four-security/scan.log
StandardError=append:/var/log/four-security/scan.log
