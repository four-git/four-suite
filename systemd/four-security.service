[Unit]
Description=Four security containers
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
RequiresMountsFor=/mnt/four-security/downloads
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/four-security
ExecStart=/usr/bin/python3 /opt/four-security/suite start
ExecStop=/usr/bin/python3 /opt/four-security/suite stop
TimeoutStartSec=180
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
